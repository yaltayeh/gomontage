{
  "$schema": "../schema/project.v1.schema.json",
  "version": 1,
  "name": "Travel montage",
  "format": {
    "width": 1920,
    "height": 1080,
    "fps": 25
  },
  "media": [
    {
      "id": "m_drive",
      "kind": "video",
      "path": "clips/drive.mp4",
      "probe": {
        "duration_ms": 60000,
        "has_video": true,
        "has_audio": true,
        "width": 1920,
        "height": 1080,
        "fps": 25
      }
    },
    {
      "id": "m_beach",
      "kind": "video",
      "path": "clips/beach.mp4",
      "probe": {
        "duration_ms": 20000,
        "has_video": true,
        "has_audio": true,
        "width": 1920,
        "height": 1080,
        "fps": 50
      }
    },
    {
      "id": "m_sunset",
      "kind": "video",
      "path": "clips/sunset.mov",
      "probe": {
        "duration_ms": 15000,
        "has_video": true,
        "has_audio": false,
        "width": 3840,
        "height": 2160,
        "fps": 24
      }
    },
    {
      "id": "m_song",
      "kind": "audio",
      "path": "audio/song.flac",
      "probe": {
        "duration_ms": 180000,
        "has_audio": true,
        "sample_rate": 48000,
        "channels": 2
      }
    }
  ],
  "tracks": [
    {
      "id": "t_main",
      "kind": "video",
      "name": "main",
      "clips": [
        {
          "id": "c_black",
          "type": "color",
          "color": "#000000",
          "at_ms": 0,
          "duration_ms": 1000
        },
        {
          "id": "c_drive",
          "type": "video",
          "label": "timelapse drive",
          "media": "m_drive",
          "at_ms": 1000,
          "out_ms": 40000,
          "include_audio": false,
          "fade_in_ms": 1000,
          "effects": [
            {
              "type": "speed",
              "factor": 4
            }
          ]
        },
        {
          "id": "c_beach",
          "type": "video",
          "label": "slow-motion waves",
          "media": "m_beach",
          "at_ms": 11000,
          "in_ms": 5000,
          "out_ms": 9000,
          "volume": 0.4,
          "transition_in": {
            "type": "crossfade",
            "duration_ms": 1000
          },
          "effects": [
            {
              "type": "speed",
              "factor": 0.5,
              "affect_audio": false
            }
          ]
        },
        {
          "id": "c_sunset",
          "type": "video",
          "media": "m_sunset",
          "at_ms": 19000,
          "in_ms": 2000,
          "out_ms": 10000,
          "fade_out_ms": 2000,
          "transition_in": {
            "type": "crossfade",
            "duration_ms": 1000
          }
        }
      ]
    },
    {
      "id": "t_music",
      "kind": "audio",
      "name": "music",
      "clips": [
        {
          "id": "c_song",
          "type": "audio",
          "media": "m_song",
          "at_ms": 0,
          "in_ms": 30000,
          "out_ms": 45000,
          "volume": 0.8,
          "fade_in_ms": 2000,
          "effects": [
            {
              "type": "normalize",
              "target_lufs": -14
            }
          ]
        },
        {
          "id": "c_song_b",
          "type": "audio",
          "label": "second part of the song",
          "media": "m_song",
          "at_ms": 15000,
          "in_ms": 100000,
          "out_ms": 112000,
          "volume": 0.8,
          "fade_out_ms": 3000,
          "transition_in": {
            "type": "crossfade",
            "duration_ms": 2000
          },
          "effects": [
            {
              "type": "normalize",
              "target_lufs": -14
            }
          ]
        }
      ]
    }
  ],
  "output": {
    "preset": "youtube_1080p",
    "path": "output/travel.mp4"
  }
}
