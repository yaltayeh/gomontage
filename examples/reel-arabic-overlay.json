{
  "$schema": "../schema/project.v1.schema.json",
  "version": 1,
  "name": "Coming soon reel",
  "format": {
    "width": 1080,
    "height": 1920,
    "fps": 30
  },
  "media": [
    {
      "id": "m_broll",
      "kind": "video",
      "path": "media/street.mov",
      "probe": {
        "duration_ms": 17120,
        "has_video": true,
        "has_audio": true,
        "width": 2160,
        "height": 3840,
        "fps": 59.94,
        "sample_rate": 44100,
        "channels": 2
      }
    },
    {
      "id": "m_logo",
      "kind": "image",
      "path": "brand/logo.png",
      "probe": {
        "width": 800,
        "height": 800
      }
    },
    {
      "id": "m_music",
      "kind": "audio",
      "path": "media/music.mp3",
      "probe": {
        "duration_ms": 95000,
        "has_audio": true,
        "sample_rate": 44100,
        "channels": 2
      }
    }
  ],
  "tracks": [
    {
      "id": "t_main",
      "kind": "video",
      "name": "footage",
      "clips": [
        {
          "id": "c_broll",
          "type": "video",
          "media": "m_broll",
          "at_ms": 0,
          "in_ms": 2000,
          "out_ms": 14000,
          "include_audio": false,
          "fade_out_ms": 500,
          "size": {
            "width": 1,
            "height": 1,
            "fit": "cover"
          }
        }
      ]
    },
    {
      "id": "t_logo",
      "kind": "video",
      "name": "logo",
      "clips": [
        {
          "id": "c_logo",
          "type": "image",
          "media": "m_logo",
          "at_ms": 0,
          "duration_ms": 12000,
          "fade_in_ms": 300,
          "position": {
            "x": 0.95,
            "y": 0.04
          },
          "anchor": "top-right",
          "size": {
            "width": 0.18
          }
        }
      ]
    },
    {
      "id": "t_titles",
      "kind": "video",
      "name": "titles",
      "clips": [
        {
          "id": "c_title",
          "type": "text",
          "text": "قريباً",
          "at_ms": 1500,
          "duration_ms": 6000,
          "fade_in_ms": 400,
          "fade_out_ms": 400,
          "style": {
            "font": {
              "family": "El Messiri"
            },
            "size": 0.07,
            "box": {
              "color": "#000000AA",
              "padding": 0.3
            }
          },
          "position": {
            "x": 0.5,
            "y": 0.85
          },
          "anchor": "bottom"
        },
        {
          "id": "c_date",
          "type": "text",
          "text": "١٥ نوفمبر\nNovember 15",
          "at_ms": 8000,
          "duration_ms": 4000,
          "fade_in_ms": 300,
          "style": {
            "font": {
              "file": "fonts/ElMessiri.ttf"
            },
            "size": 0.045,
            "outline": {
              "color": "#000000",
              "width": 0.08
            }
          }
        }
      ]
    },
    {
      "id": "t_music",
      "kind": "audio",
      "name": "music",
      "clips": [
        {
          "id": "c_music",
          "type": "audio",
          "media": "m_music",
          "at_ms": 0,
          "out_ms": 12000,
          "volume": 0.6,
          "fade_in_ms": 1000,
          "fade_out_ms": 2000
        }
      ]
    }
  ],
  "output": {
    "preset": "reel",
    "path": "output/coming-soon.mp4"
  }
}
